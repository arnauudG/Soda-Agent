# Soda-Agent Infrastructure Environment Variables
# Copy this file to .env and fill in the values
#
# IMPORTANT: Never commit .env files with real credentials to version control!
# This .env.example file documents all available environment variables.

# ============================================
# AWS Configuration
# ============================================

# AWS Region for deployment (default: eu-west-1)
# TF_VAR_aws_region=eu-west-1

# ============================================
# Soda Agent Configuration
# ============================================
# Required when deploying the soda-agent stack

# Soda Cloud API Key ID (required)
# Get this from Soda Cloud: Profile > API Keys > Create API Key
SODA_API_KEY_ID=

# Soda Cloud API Key Secret (required)
# Get this from Soda Cloud: Profile > API Keys > Create API Key
SODA_API_KEY_SECRET=

# Soda Cloud Region (optional, default: eu)
# Options: eu, us
# SODA_CLOUD_REGION=eu

# Soda Agent Log Level (optional, default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR
# SODA_LOG_LEVEL=INFO

# Soda Agent Log Format (optional, default: raw)
# Options: raw, json
# SODA_LOG_FORMAT=raw

# Image Registry API Key ID (optional)
# If not set, defaults to SODA_API_KEY_ID
# This is used to pull container images from Soda's private registry
# SODA_IMAGE_APIKEY_ID=

# Image Registry API Key Secret (optional)
# If not set, defaults to SODA_API_KEY_SECRET
# SODA_IMAGE_APIKEY_SECRET=

# ============================================
# Collibra DQ Standalone Configuration
# ============================================
# Required when deploying the collibra-dq stack

# Collibra DQ Admin Password (required)
# Password for the admin user in Collibra DQ web interface
# Must meet password complexity requirements
COLLIBRA_DQ_ADMIN_PASSWORD=

# Collibra DQ License Key (required)
# Your Collibra DQ license key
# Contact Collibra support if you don't have one
COLLIBRA_DQ_LICENSE_KEY=

# Collibra DQ Version (optional, default: 2024.11.0)
# Version of Collibra DQ to install
# COLLIBRA_DQ_VERSION=2024.11.0

# Allowed CIDR Block (optional)
# Controls which IPs can access Collibra DQ services
# - Dev default: 0.0.0.0/0 (WARNING: open to internet)
# - Prod default: VPC CIDR only
# - For security, set to your office IP: "1.2.3.4/32"
# COLLIBRA_DQ_ALLOWED_CIDR=10.10.0.0/16

# ============================================
# Collibra DQ Database Configuration
# ============================================

# RDS Database Username (optional, default: collibradq)
# Username for the PostgreSQL RDS database
# COLLIBRA_DQ_RDS_USERNAME=collibradq

# RDS Database Password (optional)
# If not set, a random password will be generated
# and stored in AWS Secrets Manager
# COLLIBRA_DQ_RDS_PASSWORD=

# ============================================
# Collibra DQ HTTPS Configuration (Production)
# ============================================

# ACM Certificate ARN (recommended for production)
# ARN of the ACM certificate for HTTPS
# If not set, ALB will use HTTP only (not recommended for prod)
# COLLIBRA_DQ_CERTIFICATE_ARN=arn:aws:acm:eu-west-1:123456789:certificate/abc-123

# ============================================
# Optional: Override Defaults
# ============================================

# EC2 Instance Type for Collibra DQ (optional)
# Default: m5.xlarge (4 vCPU, 16 GB RAM)
# COLLIBRA_DQ_INSTANCE_TYPE=m5.xlarge

# EKS Node Instance Types (optional)
# Default: t3.small for dev, t3.medium for prod
# SODA_EKS_INSTANCE_TYPES=t3.small

# ============================================
# Usage Examples
# ============================================
#
# 1. Deploy Soda Agent to dev:
#    export SODA_API_KEY_ID=your_key_id
#    export SODA_API_KEY_SECRET=your_key_secret
#    ./deploy-stack.sh soda-agent dev
#
# 2. Deploy Collibra DQ to prod:
#    export COLLIBRA_DQ_ADMIN_PASSWORD=SecurePassword123!
#    export COLLIBRA_DQ_LICENSE_KEY=your_license_key
#    export COLLIBRA_DQ_CERTIFICATE_ARN=arn:aws:acm:...
#    ./deploy-stack.sh collibra-dq prod
#
# 3. Validate environment before deployment:
#    ./scripts/validate-env.sh soda-agent dev
#    ./scripts/validate-env.sh collibra-dq prod
